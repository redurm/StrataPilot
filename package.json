{
  "name": "stratapilot",
  "productName": "StrataPilot",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop GUI for the pi coding agent on a local Strata server (RPC mode): multi-session tabs with a serial queue, session switcher, file drag & drop, and a built-in Strata monitor.",
  "license": "MIT",
  "main": "main.js",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "lint": "node scripts/lint-structure.js",
    "i18n": "node scripts/i18n-extract.js",
    "i18n:missing": "node scripts/i18n-extract.js --missing",
    "i18n:unwrapped": "node scripts/i18n-extract.js --unwrapped",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "40.10.2",
    "electron-builder": "^26.15.3"
  },
  "author": "Chris Chou",
  "homepage": "https://github.com/hpi-main/StrataPilot",
  "build": {
    "appId": "com.stratapilot.app",
    "productName": "StrataPilot",
    "artifactName": "stratapilot-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**",
      "locales/**",
      "build/icon.*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "stratapilot-${version}-${os}-${arch}-setup.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "artifactName": "stratapilot-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Development",
      "synopsis": "Desktop GUI for the pi coding agent on a local Strata server",
      "artifactName": "stratapilot-${version}-${os}-${arch}.${ext}"
    }
  }
}
